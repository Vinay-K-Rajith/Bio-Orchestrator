# Copy to .env and fill in. Every value here is optional: with none of them set
# the app still runs end to end on the rule-based parser and deterministic
# report, which is the correctness floor.

# --- Nebius Token Factory (hosted Nemotron) -------------------------------
# Get a key at https://studio.nebius.com/ -> API keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Local llama.cpp (offline fallback) -----------------------------------
# Only used when Nebius is unset or unreachable, or llm=llama is requested.
LLAMA_SERVER_URL=http://localhost:8080

# Shared ceiling for either chat backend.
LLM_TIMEOUT_SECONDS=90

# --- Tavily (literature grounding) ----------------------------------------
# Get a key at https://app.tavily.com/. Without it, reports are written
# without citations and everything else behaves identically.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Hard ceiling on Tavily calls per screening run. An agent that can search in
# a loop can also search forever; this is the stop.
EVIDENCE_MAX_TOOL_CALLS=6

# Search results are cached on disk so a demo still cites real sources weeks
# after the key was last valid. TTL is in seconds (default 30 days).
EVIDENCE_CACHE_DIR=backend/data/evidence_cache
EVIDENCE_CACHE_TTL=2592000
